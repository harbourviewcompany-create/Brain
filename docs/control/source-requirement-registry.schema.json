{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harbourviewcompany-create/Brain/docs/control/source-requirement-registry.schema.json",
  "title": "Brain Source Requirement Registry",
  "type": "object",
  "required": ["registry_id", "status", "purpose", "rules", "sources", "requirements", "code_module_records"],
  "properties": {
    "registry_id": {"type": "string"},
    "status": {"type": "string"},
    "purpose": {"type": "string"},
    "rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "path", "label"],
        "properties": {
          "source_id": {"type": "string"},
          "path": {"type": "string"},
          "label": {"enum": ["SOURCE", "APPROVED", "PROPOSAL", "SPECULATIVE", "REVIEW-ONLY", "BLOCKED", "BUILD-READY"]}
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "source_ids", "label"],
        "properties": {
          "requirement_id": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "label": {"enum": ["SOURCE", "APPROVED", "PROPOSAL", "SPECULATIVE", "REVIEW-ONLY", "BLOCKED", "BUILD-READY"]}
        }
      }
    },
    "code_module_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "paths", "classification", "go_hold_status", "source_ids", "requirement_ids", "owner_object", "schema", "runtime_service", "state_machine", "fixtures", "tests", "acceptance_criteria", "audit_events", "source_preservation", "unresolved_gaps"],
        "properties": {
          "record_id": {"type": "string"},
          "paths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "classification": {"enum": ["SOURCE", "APPROVED", "PROPOSAL", "SPECULATIVE", "REVIEW-ONLY", "BLOCKED", "BUILD-READY"]},
          "go_hold_status": {"enum": ["GO", "HOLD", "REVIEW", "BLOCKED"]},
          "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "requirement_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "owner_object": {"type": "string"},
          "schema": {"type": "string"},
          "runtime_service": {"type": "string"},
          "state_machine": {"type": "string"},
          "fixtures": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "tests": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "audit_events": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "source_preservation": {"type": "string"},
          "unresolved_gaps": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
