{
  "policy_id": "brain-agent-build-control-policy-v1",
  "status": "APPROVED_FOR_CONTROL_ENFORCEMENT",
  "purpose": "Machine-readable enforcement registry for Brain build-control documents, templates, validators, traceability records, archive workflow checks, and repository hardening audits.",
  "root_principle": "Tyler defines The Brain. Agents preserve, structure, implement, test, and report. Agents do not narrow scope or discard supplied material.",
  "source_authority_labels": [
    "SOURCE",
    "APPROVED",
    "PROPOSAL",
    "SPECULATIVE",
    "REVIEW-ONLY",
    "BLOCKED",
    "BUILD-READY"
  ],
  "go_hold_statuses": [
    "GO",
    "HOLD",
    "REVIEW",
    "BLOCKED"
  ],
  "required_control_files": [
    "docs/control/README.md",
    "docs/control/brain-build-rules.md",
    "docs/control/source-authority.md",
    "docs/control/go-hold-protocol.md",
    "docs/control/definition-of-done.md",
    "docs/control/agent-build-instructions.md",
    "docs/control/forbidden-agent-behaviors.md",
    "docs/control/traceability-rules.md",
    "docs/control/acceptance-evidence-template.md",
    "docs/control/branch-protection.md",
    "docs/control/repository-hardening-audit.md",
    "docs/control/policy-registry.json",
    "docs/control/source-requirement-registry.schema.json",
    "docs/control/source-requirement-registry.json",
    "docs/control/source-requirement-registry.convergence.json",
    "docs/control/module-build-ready-traceability.schema.json",
    "docs/control/module-build-ready-traceability.md",
    "docs/control/module-build-ready-traceability.pr126.md",
    "docs/control/source-requirement-registry.infra.json",
    "docs/control/module-build-ready-traceability.infra.md",
    "docs/control/OBSERVATORY_CONSOLIDATION_PROVENANCE.md",
    "docs/control/source-requirement-registry.observatory.json",
    "docs/control/module-build-ready-traceability.observatory.md"
  ],
  "required_templates": [
    ".github/pull_request_template.md",
    ".github/ISSUE_TEMPLATE/blocked.yml",
    ".github/ISSUE_TEMPLATE/build-ready.yml",
    ".github/ISSUE_TEMPLATE/conflict.yml",
    ".github/ISSUE_TEMPLATE/source-record.yml"
  ],
  "required_validators": [
    "scripts/validate_control_layer.py",
    "scripts/validate_archive_manifest.py",
    "scripts/validate_pr_body.py",
    "scripts/validate_build_ready_traceability.py",
    "tools/check_repository_hardening.py"
  ],
  "required_workflows": [
    ".github/workflows/control-policy.yml",
    ".github/workflows/repository-hardening.yml",
    ".github/workflows/observatory-verify.yml"
  ],
  "required_pr_template_sections": [
    "Control Preflight",
    "Scope",
    "Source Authority",
    "GO/HOLD Status",
    "Changed Files",
    "Module Completion Requirements",
    "Traceability",
    "Tests / Validation",
    "External Actions",
    "Memory Writes",
    "Acceptance Criteria",
    "Unresolved Gaps",
    "Source Preservation Statement",
    "Next Required Action"
  ],
  "module_required_fields": [
    "owner object",
    "schema",
    "runtime service",
    "state machine",
    "fixtures",
    "tests",
    "acceptance criteria",
    "audit events",
    "GO/HOLD status"
  ],
  "memory_write_required_fields": [
    "source",
    "confidence",
    "scope",
    "decay/supersession policy",
    "audit trace"
  ],
  "external_action_required_fields": [
    "approval gate",
    "target system",
    "risk assessment",
    "rollback plan",
    "verification evidence"
  ],
  "archive_policy": {
    "manifest_path": "docs/archive/archive_manifest.json",
    "allow_pending_assets": true,
    "fail_on_manifest_schema_error": true,
    "fail_on_present_asset_hash_mismatch": true,
    "fail_on_present_asset_size_mismatch": true,
    "pending_assets_status": "assets_pending_file_byte_upload"
  },
  "traceability_policy": {
    "schema_path": "docs/control/source-requirement-registry.schema.json",
    "registry_path": "docs/control/source-requirement-registry.json",
    "canonical_registry_extensions": [
      "docs/control/source-requirement-registry.convergence.json",
      "docs/control/source-requirement-registry.infra.json",
      "docs/control/source-requirement-registry.observatory.json",
      "docs/control/source-requirement-registry.hardening.json"
    ],
    "module_build_ready_schema_path": "docs/control/module-build-ready-traceability.schema.json",
    "module_build_ready_matrix_path": "docs/control/module-build-ready-traceability.md",
    "canonical_module_matrix_extensions": [
      "docs/control/module-build-ready-traceability.pr126.md",
      "docs/control/module-build-ready-traceability.infra.md",
      "docs/control/module-build-ready-traceability.observatory.md",
      "docs/control/module-build-ready-traceability.hardening.md"
    ],
    "enforced_code_roots": [
      "apps",
      "brain",
      "scripts"
    ],
    "excluded_filenames": [
      "__init__.py"
    ],
    "fail_on_missing_code_traceability": true,
    "fail_on_false_build_ready_claims": true
  },
  "pr_body_policy": {
    "validator_path": "scripts/validate_pr_body.py",
    "fail_on_missing_required_sections": true,
    "source": "GITHUB_EVENT_PATH pull_request.body"
  },
  "hardening_policy": {
    "audit_script": "tools/check_repository_hardening.py",
    "audit_workflow": ".github/workflows/repository-hardening.yml",
    "ruleset_target": ".github/rulesets/main-required-checks.ruleset.json",
    "tracked_blockers": [
      "#51",
      "#52"
    ],
    "required_main_checks": [
      "Brain Control Policy",
      "test"
    ],
    "required_archive_state": "real file bytes present and hash-verified by docs/archive/archive_manifest.json"
  },
  "forbidden_behaviors": [
    "narrow Brain scope without Tyler approval",
    "delete source material",
    "summarize without preserving source",
    "mark speculative material as false or out of scope by default",
    "treat reviewer suggestions as build authority without approval",
    "claim tests passed without evidence",
    "claim binary archive upload when only a local path was committed",
    "perform external actions without approval gates",
    "write memory without source, confidence, scope, decay/supersession policy, and audit trace"
  ]
}
