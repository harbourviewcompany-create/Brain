{
  "schema_version": "1.0.0",
  "required_common_fields": ["id", "tenant_id", "created_at", "updated_at", "provenance", "status"],
  "objects": [
    {"name":"Source","storage_table":"sources","required_fields":["id","name","source_type","reliability","status","provenance"],"optional_fields":["access_cost","false_positive_rate","historical_yield"],"enums":{"status":["active","paused","blocked","retired"]},"related_services":["SourceRegistryService"]},
    {"name":"Signal","storage_table":"signals","required_fields":["id","source_id","observed_at","claim","raw_observation_id","attention_score","status","provenance"],"optional_fields":["novelty","urgency","commercial_upside","contradiction_value"],"enums":{"status":["captured","scored","promoted","held","rejected_by_policy"]},"related_services":["PerceptionService","AttentionAllocatorService"]},
    {"name":"EvidenceItem","storage_table":"evidence_items","required_fields":["id","signal_id","claim","evidence_strength","direction","provenance"],"optional_fields":["costliness","corroboration_count"],"enums":{"direction":["supports","contradicts","context"]},"related_services":["EvidenceScoringService"]},
    {"name":"Belief","storage_table":"beliefs","required_fields":["id","statement","confidence","supporting_evidence_ids","contradicting_evidence_ids","status","provenance"],"optional_fields":["decay_rate","last_calibrated_at"],"enums":{"status":["draft","active","contradicted","superseded","retired"]},"related_services":["BeliefUpdateService","TruthMaintenanceService"]},
    {"name":"Opportunity","storage_table":"opportunities","required_fields":["id","belief_id","buyer_or_actor","pain","timing","evidence_ids","quality_score","status","provenance"],"optional_fields":["offer_path","capital_required","trust_risk"],"enums":{"status":["candidate","research","recommended","approval_required","approved","rejected","closed"]},"related_services":["OpportunityScoringService"]},
    {"name":"ApprovalRequest","storage_table":"approval_requests","required_fields":["id","candidate_action_id","external_consequence","required_approver","status","evidence_ids","provenance"],"optional_fields":["expires_at","policy_reason"],"enums":{"status":["draft","pending","approved","rejected","expired","cancelled"]},"related_services":["ApprovalQueueService","ActionGateService"]},
    {"name":"Outcome","storage_table":"outcomes","required_fields":["id","action_id","outcome_type","value","observed_at","attribution_confidence","provenance"],"optional_fields":["cash_value","time_saved","trust_impact","legal_risk"],"enums":{"outcome_type":["revenue","meeting","reply","no_reply","false_positive","risk_avoided","time_saved","loss"]},"related_services":["OutcomeLoggerService","RewardPainService"]},
    {"name":"AcceptanceReport","storage_table":"acceptance_reports","required_fields":["id","ticket_id","module_id","tests_run","fixtures_used","evidence_paths","go_hold_status","provenance"],"optional_fields":["unresolved_items","next_ticket"],"enums":{"go_hold_status":["GO","HOLD"]},"related_services":["AcceptanceReportService"]}
  ]
}
