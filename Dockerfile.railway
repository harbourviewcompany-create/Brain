FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN python -m pip install --upgrade pip

COPY pyproject.toml README.md ./
COPY brain ./brain
COPY apps ./apps
COPY tools ./tools

RUN python -m pip install -e .

CMD ["sh", "-c", "python -m uvicorn tools.live_cockpit_routes:app --host 0.0.0.0 --port ${PORT:-8080}"]
