BRAIN_ENV=development
BRAIN_API_KEY=replace-with-a-secret
BRAIN_CORS_ORIGINS=http://localhost:3000
BRAIN_EXTERNAL_ACTIONS_ENABLED=false
BRAIN_EXTERNAL_ACTION_APPROVAL_MODE=explicit

DATABASE_URL=postgresql://brain:brain@localhost:5432/brain

NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brainpassword

BRAIN_WORKER_MODE=cognition
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
BRAIN_TEMPORAL_TASK_QUEUE=brain-cognition
BRAIN_TEMPORAL_WORKFLOW_ID=brain-continuous-cognition
BRAIN_TEMPORAL_AUTOSTART=true
BRAIN_IDLE_SLEEP_SECONDS=1.0
BRAIN_MAINTENANCE_EVERY_IDLE=60
BRAIN_WORKFLOW_MAX_ITERATIONS=1000
