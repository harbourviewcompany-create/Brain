# --- Core ---
BRAIN_ENV=development
BRAIN_API_KEY=replace-with-a-secret
BRAIN_CORS_ORIGINS=http://localhost:3000
BRAIN_EXTERNAL_ACTIONS_ENABLED=false
BRAIN_EXTERNAL_ACTION_APPROVAL_MODE=explicit

# --- PostgreSQL (local docker-compose or managed Postgres/Supabase) ---
DATABASE_URL=postgresql://brain:brain@localhost:5432/brain
# Required for trusted cross-tenant worker/rebuild operations once tenant RLS is active.
BRAIN_WORKER_DATABASE_URL=

# --- Neo4j (local docker-compose or AuraDB) ---
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brainpassword
NEO4J_DATABASE=neo4j
NEO4J_PROJECTION_ENABLED=true
# Explicit tenant to rebuild; the rebuild command never performs a global wipe.
BRAIN_NEO4J_REBUILD_TENANT_ID=

# --- Cognition (who runs the loop) ---
# Exactly one process per database drives cognition, decided by a Postgres
# advisory lock rather than by configuration. A dedicated worker is the
# intended host; the API takes the lease only when nothing else holds it, so a
# deployment with no worker still thinks instead of showing CYCLE 0 forever.
# Set false to forbid the API from ever running cognition -- only do that once
# a worker is actually deployed, or nothing will run the loop at all.
BRAIN_INLINE_COGNITION=true
# How long the API holds the lease before offering it back, so a worker
# deployed later takes over without anyone restarting the API. 0 disables the
# handover.
BRAIN_INLINE_YIELD_SECONDS=300
# How often a process that lost the lease asks for it again.
BRAIN_INLINE_RETRY_SECONDS=15
BRAIN_TICK_SLEEP=1
BRAIN_INGEST_EVERY=30

# --- Temporal (local docker-compose or Temporal Cloud) ---
# Leave unset for the durable in-process cognition loop, which is the worker's
# default. Setting "temporal" without a reachable TEMPORAL_ADDRESS no longer
# dials localhost and crash-loops; the worker logs and thinks in-process.
BRAIN_WORKER_MODE=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
# Set true for TLS endpoints without an API key. API-key connections enable TLS automatically.
TEMPORAL_TLS=false
BRAIN_TEMPORAL_TASK_QUEUE=brain-cognition
BRAIN_TEMPORAL_WORKFLOW_ID=brain-continuous-cognition
BRAIN_TEMPORAL_AUTOSTART=true
BRAIN_IDLE_SLEEP_SECONDS=1.0
BRAIN_MAINTENANCE_EVERY_IDLE=60
BRAIN_WORKFLOW_MAX_ITERATIONS=1000

# --- Object storage (MinIO local or AWS S3 / R2) ---
OBJECT_STORAGE_BUCKET=brain-artifacts
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=brainminio
OBJECT_STORAGE_SECRET_KEY=brainminiopass
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_PREFIX=brain/
# For AWS-native credential providers, leave the custom OBJECT_STORAGE credentials
# empty and let boto3 use the standard provider chain, including AWS_SESSION_TOKEN.

# --- Tenant isolation (apps.api.tenant_app, the production Dockerfile entrypoint) ---
# disabled = legacy single-tenant behaviour, no membership checks (default)
# optional = verify signed context when present, allow unscoped requests through
# required = refuse every request without verified signed tenant context
BRAIN_TENANT_MODE=disabled
# HMAC key for signed tenant-context headers. Mandatory when BRAIN_TENANT_MODE=required.
BRAIN_TENANT_CONTEXT_SECRET=
# Set to 1 only for the release that applies migrations 019+ (tenant RLS).
BRAIN_TENANT_RLS_RELEASE=
# Migrator login, which must be distinct from the API runtime and worker roles.
BRAIN_MIGRATION_DATABASE_URL=
# Cap on resident per-tenant service bundles held by the API process.
BRAIN_TENANT_BUNDLE_LIMIT=64

# --- Observatory operator access (apps/observatory, set on the Vercel project) ---
# Without both of these the Observatory refuses every request; it never falls open.
OBSERVATORY_ACCESS_KEY=replace-with-a-long-random-operator-key
OBSERVATORY_SESSION_SECRET=replace-with-a-separate-long-random-secret
# Server-only. Must equal the Brain runtime's BRAIN_API_KEY.
BRAIN_API_URL=
# Set false to stop forwarding Vercel deployment identity upstream. Only the
# Dockerfile.railway entrypoint verifies it (VercelOidcAuthBridge); the canonical
# Dockerfile entrypoint authenticates on BRAIN_API_KEY alone and ignores it.
BRAIN_UPSTREAM_ACCEPTS_OIDC=true
