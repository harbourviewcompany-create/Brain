{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "comment": "Legacy nested-project compatibility only; canonical production Vercel project uses repository-root vercel.json.",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/*": true
    }
  },
  "ignoreCommand": "bash ../../scripts/vercel-ignore-build.sh"
}
