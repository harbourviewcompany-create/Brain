# Brain Observatory — server-side upstream configuration.
# Set these on Vercel → Environment Variables → Production (+ Preview if needed).
# Redeploy after changing.

# Upstream Brain Runtime API (no trailing slash). Server-only.
BRAIN_API_URL=https://brain-api-live-production.up.railway.app

# Optional server-only fallback credential. Primary production auth is Vercel deployment OIDC.
# BRAIN_API_KEY=

# Optional non-secret label in the TopBar.
NEXT_PUBLIC_OPERATOR_ID=tyler
