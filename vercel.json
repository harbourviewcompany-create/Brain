{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd apps/observatory && npm install --no-audit --no-fund && npm run build",
  "outputDirectory": "apps/observatory/.next",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/*": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh"
}
